# Server
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://your-service.onrender.com
CORS_ORIGIN=https://your-service.onrender.com

# Database and authentication
# DATABASE_URL = PostgreSQL (producción).
#   ⚠️ Las bases gratuitas de Render CADUCAN a los 30 días y Render las BORRA con
#   todos sus datos, así que en producción apunta a un Postgres gratuito que no
#   expire (por ejemplo Neon: https://neon.tech). Ejemplo:
#   DATABASE_URL=postgresql://usuario:clave@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Sin DATABASE_URL la app usa SQLite local (solo desarrollo: el disco de Render
# es efímero y se borra en cada deploy).
DATABASE_URL=
JWT_SECRET=replace-with-a-long-random-secret

# ─── Copias de seguridad en Cloud Firestore (plan gratuito, sin tarjeta) ──────
# Guía paso a paso: FIREBASE-BACKUPS.md
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Ojo: se pega con los \n literales, no con saltos de línea reales.
FIREBASE_PRIVATE_KEY=
# Alternativa a las 3 variables de arriba (JSON completo, crudo o en base64):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Desactiva las copias aunque haya credenciales (0/false/no/off)
FIRESTORE_BACKUP_ENABLED=1
# Minutos entre copias automáticas (default 60, mínimo 5)
FIRESTORE_BACKUP_INTERVAL_MINUTES=60
# Colección donde se guardan las copias (default db_backups)
FIRESTORE_BACKUP_COLLECTION=db_backups
# Tamaño máximo del volcado en MB (default 150)
FIRESTORE_BACKUP_MAX_MB=150
# Tablas a omitir en la copia, separadas por coma (ej: location_history)
FIRESTORE_BACKUP_SKIP_TABLES=
# Al arrancar: if-empty (restaura solo si la base está vacía) | force | off
FIRESTORE_RESTORE=if-empty

# OpenAI monitoring assistant (server-side only; never expose this key in frontend code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_MAX_OUTPUT_TOKENS=900
ASSISTANT_RATE_LIMIT_WINDOW_MS=60000
ASSISTANT_RATE_LIMIT_MAX=10

# Ghosty — WhatsApp Cloud API (Meta Business Platform)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_VERIFY_TOKEN=ghosty-verify-change-me
META_WHATSAPP_APP_SECRET=
