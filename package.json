{
  "name": "agencia-domicilios",
  "version": "2.0.0",
  "description": "Plataforma de agencia de domicilios: pedidos, repartidores y seguimiento en tiempo real con mapa",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "seed": "node db/seed.js",
    "backup:status": "node scripts/firestore-backup.mjs status",
    "backup:firestore": "node scripts/firestore-backup.mjs backup",
    "restore:firestore": "node scripts/firestore-backup.mjs restore",
    "verify:firestore": "node scripts/verify-backup.mjs",
    "test:backup-local": "node scripts/test-backup-local.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "delivery",
    "fleet",
    "tracking",
    "realtime",
    "map",
    "leaflet",
    "socket.io"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.19.2",
    "firebase-admin": "^14.4.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.0",
    "socket.io": "^4.7.5",
    "sql.js": "^1.11.0",
    "web-push": "^3.6.7"
  }
}
